{% extends 'base.twig' %}

{% block documentTitle %}Connexion{% endblock %}

{% block main %}
<main class="login-container">
    <h1 id="login-heading">Connexion à votre compte</h1>
    
    <form 
        action="/login" 
        method="post" 
        aria-labelledby="login-heading"
        aria-describedby="login-instructions"
    >
        <div role="alert" aria-live="assertive">
            {% if error %}
                <p class="error-message">{{ error }}</p>
            {% endif %}
        </div>

        <div id="login-instructions" class="sr-only">
            Veuillez remplir les champs suivants pour vous connecter
        </div>

        <div class="form-group">
            <label for="username">Pseudo :</label>
            <input
                type="text"
                id="username"
                name="username"
                required
                aria-required="true"
                autocomplete="username"
                aria-describedby="username-help"
            >
            <span id="username-help" class="help-text">Votre identifiant unique</span>
        </div>

        <div class="form-group">
            <label for="password">Mot de passe :</label>
            <input
                type="password"
                id="password"
                name="password"
                required
                aria-required="true"
                autocomplete="current-password"
                aria-describedby="password-help"
            >
            <span id="password-help" class="help-text">8 caractères minimum</span>
        </div>

        <button type="submit" class="btn-primary">
            <span aria-hidden="true">🔑</span>
            Se connecter
        </button>
    </form>
</main>
{% endblock %}