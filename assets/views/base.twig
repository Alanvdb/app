<!DOCTYPE html>
<html lang="en">
<head>
    <title>
        {% block documentTitle %}
            Untitled document
        {% endblock %}
    </title>

    {% block metaTags %}
        <meta charset="{{ _charset }}">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="/css/library/index.css">
    {% endblock %}

    {% block scripts %}
    {% endblock %}

    {% block style %}
    {% endblock %}
</head>
<body>
    <header role="banner">
        <hgroup>
            <img src="img/logo.png" alt="Logo">
            <p>My website</p>
            <p>Designed from scratch !</p>
        </hgroup>
        <nav>
            <menu>
                <li><a href="{{ uriGenerator.generateUri('home') }}">Home</a></li>
                {% if session.has('connected') and session.get('connected') %}
                    <li><a href="{{ uriGenerator.generateUri('logout') }}">Logout</a></li>
                {% else %}
                    <li><a href="{{ uriGenerator.generateUri('login') }}">Login</a></li>
                {% endif %}
            </menu>
        </nav>
    </header>
    {% block main %}
    {% endblock %}
    <footer role="contentinfo">
        <p>© 2025 AlanVdb</p>
    </footer>
</body>