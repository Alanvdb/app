{% import "bootstrap/macro/menus.twig" as menus %}

<!DOCTYPE html>
{% block htmlTag %}
    <html lang="en" {# data-bs-theme="dark" #}>
{% endblock %}
<head>
    <title>
        {% block documentTitle %}
            Untitled document
        {% endblock %}
    </title>

    {% block metaTags %}
        <meta charset="{{ _charset }}">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="/bootstrap-5.3.3-dist/css/bootstrap.min.css">
    {% endblock %}

    {% block scripts %}
    {% endblock %}

    {% block style %}
    {% endblock %}
</head>

{% block bodyTag %}
<body>
{% endblock %}

{% block svgDefinitions %}
{% endblock %}

{% block header %}
    <header class="container d-flex flex-wrap justify-content-center py-3 mb-4 border-bottom">
        <a href="{{ uriGenerator.generateUri('home') }}" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
            <img class="bi me-2" width="40" height="40" src="/img/logo.png">&nbsp;<span class="fs-4">Chiphpmunk&nbsp;<sup><span class="badge text-bg-primary">v0.8</span></sup></span>
        </a>
        <a href="https://github.com/Alanvdb" title="AlanVdb Github profile">
            <svg height="32" aria-hidden="true" viewBox="0 0 24 24" version="1.1" width="32" data-view-component="true">
                <path d="M12.5.75C6.146.75 1 5.896 1 12.25c0 5.089 3.292 9.387 7.863 10.91.575.101.79-.244.79-.546 0-.273-.014-1.178-.014-2.142-2.889.532-3.636-.704-3.866-1.35-.13-.331-.69-1.352-1.18-1.625-.402-.216-.977-.748-.014-.762.906-.014 1.553.834 1.769 1.179 1.035 1.74 2.688 1.25 3.349.948.1-.747.402-1.25.733-1.538-2.559-.287-5.232-1.279-5.232-5.678 0-1.25.445-2.285 1.178-3.09-.115-.288-.517-1.467.115-3.048 0 0 .963-.302 3.163 1.179.92-.259 1.897-.388 2.875-.388.977 0 1.955.13 2.875.388 2.2-1.495 3.162-1.179 3.162-1.179.633 1.581.23 2.76.115 3.048.733.805 1.179 1.825 1.179 3.09 0 4.413-2.688 5.39-5.247 5.678.417.36.776 1.05.776 2.128 0 1.538-.014 2.774-.014 3.162 0 .302.216.662.79.547C20.709 21.637 24 17.324 24 12.25 24 5.896 18.854.75 12.5.75Z"></path>
            </svg>
        </a>
        {#} {{ menus.nav([{label: 'Github', uri: 'https://github.com/Alanvdb', current: false}]) }} {#}
    </header>
{% endblock %}

{% block main %}
{% endblock %}

{% block footer %}
    <footer class="container d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
        <div class="col-md-4 d-flex align-items-center">
            <a href="/" class="mb-3 me-2 mb-md-0 text-body-secondary text-decoration-none lh-1">
            <svg class="bi" width="30" height="24"><use xlink:href="#bootstrap"></use></svg>
            </a>
            <span class="mb-3 mb-md-0 text-body-secondary">© 2024 AlanVdb</span>
        </div>
        {#}
        <ul class="nav col-md-4 justify-content-end list-unstyled d-flex">
            <li class="ms-3"><a class="text-body-secondary" href="#"><svg class="bi" width="24" height="24"><use xlink:href="#twitter"></use></svg></a></li>
            <li class="ms-3"><a class="text-body-secondary" href="#"><svg class="bi" width="24" height="24"><use xlink:href="#instagram"></use></svg></a></li>
            <li class="ms-3"><a class="text-body-secondary" href="#"><svg class="bi" width="24" height="24"><use xlink:href="#facebook"></use></svg></a></li>
        </ul>
        {#}
  </footer>
{% endblock %}

{% block footerScripts %}
    <script src="/bootstrap-5.3.3-dist/js/bootstrap.bundle.min.js"></script>
    <script src="/bootstrap-5.3.3-dist/js/masonry.min.js"></script>
{% endblock %}
</body>
</html>