{% extends 'base.twig' %}

{% block documentTitle "Chiphpmunk | Home" %}

{% set improvements = [
    { title: "alanvdb/orm", description: "Le nom 'alanvdb/orm' n'est pas assez explicite. Il serait plus approprié de l'appeler 'alanvdb/doctrine-factory' !" },
    { title: "Et les containers de services ?", description: "Il serait utile de créer des services organisés dans le fichier <small class=\"text-body-secondary\">/config/bootstrap.php</small>.<br>Les services sont essentiels pour garantir l'interopérabilité de l'application." },
    { title: "Pas seulement MySQL et SQLite, mais...", description: "Quels autres systèmes de gestion de bases de données Doctrine peut-il prendre en charge ?" },
    { title: "Ha ! Ha ! Piraterie !", description: "Toujours pas de middleware CSRF ?" },
] %}

{% block main %}
<main class="container">

    <h1 class="mt-5 mb-5">Yeah ! You did it !</h1>
          
    <p class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        Chiphpmunk is a PHP framework created for personal study purposes. Currently, this system should not be used in production.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </p>

    <h2 class="mt-5 mb-5">Framework Components</h2>

    <div class="row" data-masonry="{"percentPosition": true }">
        
        <div class="col">

            {# vulcas/phpdotenv #}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <img width="32" height="32" src="https://avatars.githubusercontent.com/u/187?s=48&amp;v=4">&nbsp;&nbsp;vulcas/phpdotenv
                    </h3>
                    <p class="card-text">Charge les variables d'environnement depuis le fichier <small class="text-body-secondary">/.env</small> pour une configuration sécurisée et flexible.</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Initialisé et utilisé dans <small class="text-body-secondary">/config/bootstrap.php</small>.</li>
                    <li class="list-group-item">Découvrez le projet <a class="card-link" href="https://github.com/vulcas/phpdotenv">vulcas/phpdotenv</a> sur Github.</li>
                </ul>
            </div>

            {# alanvdb/router #}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <img width="32" height="32" src="https://avatars.githubusercontent.com/u/35227520?v=4">&nbsp;&nbsp;alanvdb/router
                    </h3>
                    <p class="card-text">Un système de routage simple et facile à utiliser pour vos applications PHP.</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">La configuration se trouve dans <small class="text-body-secondary">/config/routes.php</small>, et l'initialisation se fait dans <small class="text-body-secondary">/config/bootstrap.php</small>.</li>
                    <li class="list-group-item">Découvrez le projet <a href="https://github.com/alanvdb/router" class="card-link">alanvdb/router</a> sur Github.</li>
                </ul>
            </div>

        </div>

        <div class="col">

            {# guzzle/psr7 #}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <img width="32" height="32" src="https://avatars.githubusercontent.com/u/638632?s=48&amp;v=4">&nbsp;&nbsp;guzzle/psr7
                    </h3>
                    <p class="card-text">Obtenez une implémentation robuste du standard <a href="https://www.php-fig.org/psr/psr-7/">PSR-7</a> pour la gestion des requêtes et réponses HTTP.</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item text-body-secondary">Des usines dédiées sont également disponibles via <code>alanvdb/guzzle-psr7-factories</code>.</li>
                    <li class="list-group-item">Découvrez le projet <a href="https://github.com/guzzle/psr7" class="card-link">guzzle/psr7 sur GitHub</a>.</li>
                </ul>
            </div>


            {# doctrine/orm #}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <img width="32" height="32" src="https://www.doctrine-project.org/logos/doctrine-logo.svg?1a5b7c">&nbsp;&nbsp;doctrine/orm
                    </h3>
                    <p class="card-text">Utilisez les attributs PHP 8 pour définir le schéma de votre base de données et accéder à l'objet EntityManager, simplifiant ainsi la gestion des entités et les opérations sur la base de données.</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Chiphpmunk prend en charge MySQL et SQLite via les attributs de métadonnées des classes PHP, offrant une gestion flexible et simplifiée des bases de données avec les dernières fonctionnalités de PHP.</li>
                    <li class="list-group-item"><a href="https://www.doctrine-project.org/projects/doctrine-orm/en/current/reference/attributes-reference.html#attributes-reference" class="card-link">Référence des attributs Doctrine</a></li>
                </ul>
            </div>


        </div>

        <div class="col">

            {# alanvdb/middleware-dispatcher #}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <img width="32" height="32" src="https://avatars.githubusercontent.com/u/35227520?v=4">&nbsp;&nbsp;alanvdb/middleware-dispatcher
                    </h3>
                    <p class="card-text">Un gestionnaire de middleware conforme à la spécification PSR-15, permettant de gérer facilement les couches intermédiaires de votre application.</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Implémenté et utilisé dans le fichier <small class="text-body-secondary">/config/bootstrap.php</small>.</li>
                    <li class="list-group-item">Découvrez le projet <a href="https://github.com/alanvdb/middleware-dispatcher" class="card-link">alanvdb/middleware-dispatcher sur GitHub</a>.</li>
                </ul>
            </div>


            {# twig/twig #}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">
                        <img width="32" height="32" src="https://twig.symfony.com/images/logo.md.png">&nbsp;&nbsp;twig/twig
                    </h3>
                    <p class="card-text">Le moteur de templates Symfony utilisé pour générer des vues dynamiques et flexibles.</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Créez vos templates dans le répertoire <small class="text-body-secondary">/assets/views</small>.</li>
                    <li class="list-group-item">Consultez la <a href="https://twig.symfony.com/doc/3.x/" class="card-link">documentation officielle</a> pour plus d'informations.</li>
                </ul>
            </div>


        </div>
    </div>

    <div class="mx-auto">
        <h2 class="mt-5 mb-4 text-center text-primary fw-bold">Questions et Améliorations Futures</h2>
        <div class="my-4 p-4 bg-light rounded shadow-lg">
            {% for improvement in improvements %}
                <div class="mb-4 p-4 bg-white rounded shadow-sm border">
                    <h5 class="text-dark fw-semibold mb-3">{{ improvement.title|raw }}</h5>
                    <p class="text-body-secondary mb-0 lh-lg">
                        {{ improvement.description|raw }}
                    </p>
                </div>
            {% endfor %}
        </div>
    </div>

</main>
{% endblock %}